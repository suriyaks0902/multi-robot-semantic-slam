Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1.0
      Color: 200; 200; 200
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 150
      Reference Frame: world
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Robot Description: robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1.0
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Map - Robot 1
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_1/map
      Alpha: 0.5 
      Color Scheme: costmap
      Draw Behind: true
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /robot_1/map_updates
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Map - Robot 2
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_2/map
      Alpha: 0.5
      Color Scheme: costmap
      Draw Behind: true
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /robot_2/map_updates
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: LaserScan
      Topic: /scan
      Size (m): 0.05
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Use Fixed Frame: true
      Use Rainbow: false
      Queue Size: 10
      Selectable: true
      Alpha: 1.0
      Decay Time: 0.0
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Semantic Map (local)
      Queue Size: 10
      Topic: /semantic_mapper/semantic_map_markers
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Semantic Map - Robot 1
      Queue Size: 10
      Topic: /robot_1/semantic_mapper/semantic_map_markers
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Semantic Map - Robot 2
      Queue Size: 10
      Topic: /robot_2/semantic_mapper/semantic_map_markers
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Semantic Map - Robot 3
      Queue Size: 10
      Topic: /robot_3/semantic_mapper/semantic_map_markers
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Semantic Map - Global
      Queue Size: 10
      Topic: /semantic_fleet/global_semantic_map_markers
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Camera
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/image_raw
      Transport Hint: raw
      Normalize Range: true
      Queue Size: 2
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: YOLO Detections  
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /yolo_detector/detection_visualization
      Transport Hint: raw
      Normalize Range: true
      Queue Size: 2
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Odometry
      Topic: /odom
      Shape: Arrow
      Color: 52; 101; 164
      Alpha: 0.8
      Shaft Length: 0.5
      Shaft Radius: 0.05
      Head Length: 0.2
      Head Radius: 0.1
      Keep: 200
      Covariance:
        Orientation:
          Color: 255; 255; 127
          Scale: 1.0
          Value: false
        Position:
          Color: 204; 51; 204
          Scale: 1.0
          Value: false
  Enabled: true
  Global Options:
    Background Color: 25; 25; 30
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/SetGoal
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Enable Stereo Rendering: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 0.785
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 1000
  Width: 1600
  X: 100
  Y: 50
